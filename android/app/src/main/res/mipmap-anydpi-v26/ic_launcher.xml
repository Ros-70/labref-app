<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (Android 8.0+). The two layers are masked by the
  launcher into whatever shape the device uses — circle, squircle, rounded
  square — so neither layer may carry its own border or rounding.
  The square ic_launcher.png in the density buckets is the pre-8.0 fallback.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
