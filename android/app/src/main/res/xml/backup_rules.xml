<?xml version="1.0" encoding="utf-8"?>
<!--
  Only consulted if android:allowBackup is switched to true. It is false by
  default; see the comment in AndroidManifest.xml for why.
  WebView localStorage lives under app_webview/, which is what carries My Lab
  values, so that is the only thing worth including.
-->
<full-backup-content>
    <include domain="database" path="app_webview/" />
    <exclude domain="database" path="app_webview/Default/GPUCache/" />
</full-backup-content>
